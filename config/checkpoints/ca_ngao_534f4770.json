  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 3.24,
      "text": "當冰冷的手術刀划骨我的似知識",
      "original_text": "當冰冷的手術刀划骨我的似知識"
    },
    {
      "id": 2,
      "start": 3.24,
      "end": 4.64,
      "text": "身體的每個細胞",
      "original_text": "身體的每個細胞"
    },
    {
      "id": 3,
      "start": 4.64,
      "end": 6.44,
      "text": "仿佛都在哀好",
      "original_text": "仿佛都在哀好"
    },
    {
      "id": 4,
      "start": 6.44,
      "end": 7.5200000000000005,
      "text": "我不明白",
      "original_text": "我不明白"
    },
    {
      "id": 5,
      "start": 7.5200000000000005,
      "end": 8.4,
      "text": "我的基礎",
      "original_text": "我的基礎"
    },
    {
      "id": 6,
      "start": 8.4,
      "end": 10.68,
      "text": "明明撞刻著永生的密碼",
      "original_text": "明明撞刻著永生的密碼"
    },
    {
      "id": 7,
      "start": 10.68,
      "end": 13.76,
      "text": "許仁活不過短短二十雨災",
      "original_text": "許仁活不過短短二十雨災"
    },
    {
      "id": 8,
      "start": 13.76,
      "end": 15.92,
      "text": "或許你們從未見過我",
      "original_text": "或許你們從未見過我"
    },
    {
      "id": 9,
      "start": 15.92,
      "end": 18.48,
      "text": "也從未真正認識過我",
      "original_text": "也從未真正認識過我"
    },
    {
      "id": 10,
      "start": 18.48,
      "end": 19.76,
      "text": "我是美西園",
      "original_text": "我是美西園"
    },
    {
      "id": 11,
      "start": 19.76,
      "end": 21.52,
      "text": "也叫六交恐龍",
      "original_text": "也叫六交恐龍"
    },
    {
      "id": 12,
      "start": 21.52,
      "end": 23.44,
      "text": "你們稱我為長不大的龍",
      "original_text": "你們稱我為長不大的龍"
    },
    {
      "id": 13,
      "start": 23.44,
      "end": 25.48,
      "text": "雖然驚喜來威風領領",
      "original_text": "雖然驚喜來威風領領"
    },
    {
      "id": 14,
      "start": 25.48,
      "end": 26.6,
      "text": "可實際上",
      "original_text": "可實際上"
    },
    {
      "id": 15,
      "start": 26.6,
      "end": 29.560000000000002,
      "text": "我不過是一隻習慣的躲在湖底隱暗處",
      "original_text": "我不過是一隻習慣的躲在湖底隱暗處"
    },
    {
      "id": 16,
      "start": 29.560000000000002,
      "end": 32.72,
      "text": "靠著六根與壯災呼吸的小傢伙",
      "original_text": "靠著六根與壯災呼吸的小傢伙"
    },
    {
      "id": 17,
      "start": 32.72,
      "end": 35.440000000000005,
      "text": "我們從三敵及時期就一存在",
      "original_text": "我們從三敵及時期就一存在"
    },
    {
      "id": 18,
      "start": 35.440000000000005,
      "end": 37.84,
      "text": "後應擁有不特的再生能力",
      "original_text": "後應擁有不特的再生能力"
    },
    {
      "id": 19,
      "start": 37.84,
      "end": 39.400000000000006,
      "text": "被你們所發現",
      "original_text": "被你們所發現"
    },
    {
      "id": 20,
      "start": 39.400000000000006,
      "end": 40.2,
      "text": "於是",
      "original_text": "於是"
    },
    {
      "id": 21,
      "start": 40.2,
      "end": 42.84,
      "text": "我們這些拒絕長大的古老生領",
      "original_text": "我們這些拒絕長大的古老生領"
    },
    {
      "id": 22,
      "start": 42.84,
      "end": 45.84,
      "text": "便被盡於推動人類進化的後往",
