      "start": 73.6,
      "end": 74.72,
      "text": "二十四小時內",
      "original_text": "二十四小時內"
    },
    {
      "id": 39,
      "start": 74.72,
      "end": 76.6,
      "text": "血管回收縮之血",
      "original_text": "血管回收縮之血"
    },
    {
      "id": 40,
      "start": 76.6,
      "end": 78.6,
      "text": "巨式細胞大量聚集",
      "original_text": "巨式細胞大量聚集"
    },
