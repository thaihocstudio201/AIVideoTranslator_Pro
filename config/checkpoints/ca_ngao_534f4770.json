      "start": 53.0,
      "end": 54.08,
      "text": "進行分裂",
      "original_text": "進行分裂"
    },
    {
      "id": 27,
      "start": 54.08,
      "end": 54.84,
      "text": "復原",
      "original_text": "復原"
    },
    {
      "id": 28,
      "start": 54.84,
      "end": 56.160000000000004,
      "text": "衝生",
      "original_text": "衝生"
    },
    {
      "id": 29,
      "start": 56.160000000000004,
      "end": 57.56,
      "text": "我能修復斷維",
      "original_text": "我能修復斷維"
    },
    {
      "id": 30,
      "start": 57.56,
      "end": 59.84,
      "text": "殘殖已經適往我破損",
      "original_text": "殘殖已經適往我破損"
    },
