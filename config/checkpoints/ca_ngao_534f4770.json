      "id": 31,
      "start": 59.84,
      "end": 61.72,
      "text": "甚至能再造心臟",
      "original_text": "甚至能再造心臟"
    },
    {
      "id": 32,
      "start": 61.72,
      "end": 64.52,
      "text": "這些在你們眼中是在生的奇蹟",
      "original_text": "這些在你們眼中是在生的奇蹟"
    },
